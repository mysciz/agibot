# 本机同时跑端口 A（模型）和端口 B（机器人）
MODEL_HOST=127.0.0.1
MODEL_PORT=8800
MODEL_URL=http://127.0.0.1:8800
ROBOT_HOST=127.0.0.1
ROBOT_PORT=8801

ACTION_SOURCE=file
ACTIONS_FILE=deploy/examples/joint0_wiggle.json
GRIPPER=omnipicker

# 归一化 0/1 对应的最大 Δθ。0.5 表示这一关节不动。
MAX_JOINT_STEP=0.10
MAX_GRIPPER_STEP=0.30
LIMIT_MARGIN=0.02
JOINT_VELOCITY=0.20

MAX_STEPS=4
OPEN_LOOP_HORIZON=1
MOCK=0
NO_MOVE=0
NO_CAMERA=0
PYTHON=python
